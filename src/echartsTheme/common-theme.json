		"axisLine": {
			"show": false,
			"lineStyle": {
				"color": "#000"
			}
		},
		"axisTick": {
			"show": false,
			"lineStyle": {
				"color": "#000"
			}
		},
		"axisLabel": {
			"show": true,
			"color": "#CBDDFF",
